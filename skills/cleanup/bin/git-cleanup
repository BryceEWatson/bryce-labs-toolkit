#!/bin/sh
# POSIX shell wrapper for git-cleanup
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$SCRIPT_DIR/git-cleanup.py" "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "$SCRIPT_DIR/git-cleanup.py" "$@"
else
  echo "python3/python not found (requires Python 3.8+)" >&2
  exit 1
fi
