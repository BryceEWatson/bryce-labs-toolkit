{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lessons-extractor configuration",
  "description": "Configuration schema for the lessons-extractor skill (v1.4.0)",
  "type": "object",
  "properties": {
    "logGlob": {
      "type": "string",
      "description": "Base directory for Claude Code log files (user home scoped)",
      "default": "~/.claude/projects"
    },
    "redactPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regex patterns for data to redact. Plain strings use 'gi' flags. Use /pattern/flags syntax for custom flags (e.g., '/secret/i').",
      "default": [
        "api[_-]?key[\"']?\\s*[:=]\\s*[\"']?[\\w-]+",
        "password[\"']?\\s*[:=]\\s*[\"']?[^\\s\"']+",
        "secret[\"']?\\s*[:=]\\s*[\"']?[\\w-]+",
        "token[\"']?\\s*[:=]\\s*[\"']?[\\w-]+",
        "/Users/[^/]+/",
        "/home/[^/]+/",
        "C:\\\\Users\\\\[^\\\\]+\\\\"
      ]
    },
    "outputDir": {
      "type": "string",
      "description": "Directory for output files (relative to project root)",
      "default": "docs/ai/lessons-extractor"
    },
    "preprocessor": {
      "type": "object",
      "description": "Preprocessor-specific settings for efficient log processing",
      "properties": {
        "maxLogsPerRun": {
          "type": "integer",
          "description": "Maximum log files to process per run",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "truncateContentLength": {
          "type": "integer",
          "description": "Maximum length for content fields before truncation",
          "default": 3000,
          "minimum": 500,
          "maximum": 10000
        },
        "skipExtractorSessions": {
          "type": "boolean",
          "description": "Skip sessions that are running lessons-extractor",
          "default": true
        },
        "cursorFile": {
          "type": "string",
          "description": "Filename for cursor (incremental processing state)",
          "default": ".lessons-cursor.json"
        },
        "maxRecentFiles": {
          "type": "integer",
          "description": "Maximum files to track in cursor for incremental runs",
          "default": 200,
          "minimum": 10,
          "maximum": 1000
        },
        "maxOutputSizeBytes": {
          "type": "integer",
          "description": "Maximum output file size in bytes",
          "default": 5000000,
          "minimum": 50000,
          "maximum": 10000000
        },
        "followSymlinks": {
          "type": "boolean",
          "description": "Follow symbolic links when discovering logs",
          "default": false
        },
        "windowing": {
          "type": "object",
          "description": "Two-window reading configuration (head+tail for large files)",
          "properties": {
            "headBytes": {
              "type": "integer",
              "description": "Bytes to read from file start",
              "default": 60000,
              "minimum": 5000,
              "maximum": 500000
            },
            "tailBytes": {
              "type": "integer",
              "description": "Bytes to read from file end",
              "default": 40000,
              "minimum": 5000,
              "maximum": 500000
            },
            "headEvents": {
              "type": "integer",
              "description": "Max events from head window",
              "default": 250,
              "minimum": 10,
              "maximum": 1000
            },
            "tailEvents": {
              "type": "integer",
              "description": "Max events from tail window",
              "default": 250,
              "minimum": 10,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "discovery": {
          "type": "object",
          "description": "Log discovery scalability settings",
          "properties": {
            "maxDepth": {
              "type": "integer",
              "description": "Directory depth limit (0=unlimited)",
              "default": 10,
              "minimum": 0,
              "maximum": 50
            },
            "maxDirectories": {
              "type": "integer",
              "description": "Directory count limit (0=unlimited)",
              "default": 1000,
              "minimum": 0,
              "maximum": 10000
            },
            "earlyStopCount": {
              "type": "integer",
              "description": "Stop after N recent files (0=disabled)",
              "default": 0,
              "minimum": 0,
              "maximum": 1000
            },
            "earlyStopAgeDays": {
              "type": "integer",
              "description": "Recent = modified within N days",
              "default": 7,
              "minimum": 1,
              "maximum": 90
            }
          },
          "additionalProperties": false
        },
        "sampling": {
          "type": "object",
          "description": "Event sampling configuration",
          "properties": {
            "contextEvents": {
              "type": "integer",
              "description": "Events from session start",
              "default": 20,
              "minimum": 5,
              "maximum": 100
            },
            "resolutionEvents": {
              "type": "integer",
              "description": "Events from session end",
              "default": 20,
              "minimum": 5,
              "maximum": 100
            },
            "errorWindowEvents": {
              "type": "integer",
              "description": "Events around errors",
              "default": 5,
              "minimum": 1,
              "maximum": 20
            },
            "importanceWindowEvents": {
              "type": "integer",
              "description": "Events around importance markers",
              "default": 5,
              "minimum": 1,
              "maximum": 20
            },
            "taskPreviewLength": {
              "type": "integer",
              "description": "Max chars for taskPreview field",
              "default": 200,
              "minimum": 50,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "indexing": {
          "type": "object",
          "description": "Cursor index configuration for caching derived metadata (v1.2.0)",
          "properties": {
            "maxEntries": {
              "type": "integer",
              "description": "Maximum entries in cursor index",
              "default": 500,
              "minimum": 50,
              "maximum": 5000
            },
            "maxAgeDays": {
              "type": "integer",
              "description": "Prune entries older than N days (0=disabled)",
              "default": 30,
              "minimum": 0,
              "maximum": 365
            },
            "pruneStrategy": {
              "type": "string",
              "description": "Pruning strategy: lru, age, or hybrid",
              "enum": ["lru", "age", "hybrid"],
              "default": "hybrid"
            },
            "preserveUserFields": {
              "type": "boolean",
              "description": "Preserve user tags/notes when updating entries",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "failureDetection": {
          "type": "object",
          "description": "Tool failure detection configuration (v1.4.0)",
          "properties": {
            "mode": {
              "type": "string",
              "description": "Detection mode: strict (exitCode only), balanced (+ fatal patterns for shell tools), heuristic (+ broad patterns with threshold)",
              "enum": ["strict", "balanced", "heuristic"],
              "default": "strict"
            },
            "regexToolAllowlist": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tools eligible for regex-based failure detection",
              "default": ["Bash", "PowerShell"]
            },
            "regexToolDenylist": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tools excluded from regex fallback (takes precedence over allowlist)",
              "default": ["Read", "Edit", "Write", "Glob", "Grep"]
            },
            "minBroadMatches": {
              "type": "integer",
              "description": "Minimum broad pattern matches to trigger failure (heuristic mode)",
              "default": 2,
              "minimum": 1,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "scopeDetection": {
          "type": "object",
          "description": "Run scope detection for lesson generation guidance (v1.4.0)",
          "properties": {
            "incrementalThreshold": {
              "type": "integer",
              "description": "Minimum new sessions for 'substantial' scope (below = 'incremental')",
              "default": 5,
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "maxBytesPerLog": {
          "type": "integer",
          "description": "DEPRECATED: Use windowing.headBytes + windowing.tailBytes instead",
          "deprecated": true
        },
        "maxEventsPerLog": {
          "type": "integer",
          "description": "DEPRECATED: Use windowing.headEvents + windowing.tailEvents instead",
          "deprecated": true
        },
        "contextEventsCount": {
          "type": "integer",
          "description": "DEPRECATED: Use sampling.contextEvents instead",
          "deprecated": true
        },
        "resolutionEventsCount": {
          "type": "integer",
          "description": "DEPRECATED: Use sampling.resolutionEvents instead",
          "deprecated": true
        },
        "errorWindowEvents": {
          "type": "integer",
          "description": "DEPRECATED: Use sampling.errorWindowEvents instead",
          "deprecated": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
